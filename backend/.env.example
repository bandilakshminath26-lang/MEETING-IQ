# =================================================
# Meeting Intelligence Agent — Environment Variables
# =================================================
# Copy this file to .env and fill in your API keys.

# Database (SQLite by default for development)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_intelligence
# DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/meeting_intelligence

# Hindsight (Vectorize) — Long-term Memory
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_MEMORY_BANK_ID=meeting-intelligence

# LLM Provider (Groq)
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_PROVIDER=groq

# Application
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# Optional: OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=
